# ============================================
# iSKRA Tour - Apache Configuration
# ============================================

# Включение RewriteEngine (для редиректов и правил)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # ВРЕМЕННО ОТКЛЮЧЕНО - редиректы создают цикл из-за конфликта с настройками хостинга
  # Проверьте в панели хостинга, есть ли там уже настроенные редиректы (HTTP→HTTPS, www→без www)
  # Если редиректы уже настроены на хостинге - удалите эти правила из .htaccess
  # Если редиректов нет на хостинге - раскомментируйте правила ниже
  
  # # Если есть www - убираем www и принудительно HTTPS
  # RewriteCond %{HTTP_HOST} ^www\.iskra-tour\.ru$ [NC]
  # RewriteRule ^(.*)$ https://iskra-tour.ru%{REQUEST_URI} [R=301,L]
  # 
  # # Если нет HTTPS (и нет www) - принудительно HTTPS
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP_HOST} ^iskra-tour\.ru$ [NC]
  # RewriteRule ^(.*)$ https://iskra-tour.ru%{REQUEST_URI} [R=301,L]
</IfModule>

# ============================================
# Кэширование статики
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On
  
  # CSS и JavaScript
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  
  # Изображения
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/jpg "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Шрифты
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  
  # HTML (короткое кеширование для обновлений контента)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================
# Сжатие (Gzip)
# ============================================
<IfModule mod_deflate.c>
  # Сжимать HTML, CSS, JavaScript, Text, XML и шрифты
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ============================================
# Безопасность
# ============================================

# Защита от прямого доступа к конфигурационным файлам
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|json|md)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Защита секретных файлов
<FilesMatch "iskra_secrets\.php$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Защита от просмотра директорий
Options -Indexes

# Защита от некоторых типов атак
<IfModule mod_headers.c>
  # XSS Protection
  Header set X-XSS-Protection "1; mode=block"
  
  # Clickjacking Protection
  Header set X-Frame-Options "SAMEORIGIN"
  
  # MIME Type Sniffing Protection
  Header set X-Content-Type-Options "nosniff"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================
# MIME типы
# ============================================
<IfModule mod_mime.c>
  # WebP поддержка
  AddType image/webp .webp
  
  # Шрифты
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType application/font-woff .woff
  AddType application/font-woff2 .woff2
</IfModule>

# ============================================
# Кодировка по умолчанию
# ============================================
AddDefaultCharset UTF-8

# ============================================
# Обработка ошибок (опционально)
# ============================================
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html

